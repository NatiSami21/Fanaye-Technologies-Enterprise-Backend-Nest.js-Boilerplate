# Application
NODE_ENV=development
APP_PORT=4000
APP_API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
APP_HEADER_LANGUAGE=x-custom-lang
FRONTEND_DOMAIN=http://localhost:3000
BACKEND_DOMAIN=http://localhost:4000

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://fanaye:fanaye_secret@localhost:5432/fanaye_db?schema=public

# Redis & Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Authentication
AUTH_JWT_SECRET=super-secret-jwt-key-min-32-chars-fanaye-2026
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=super-secret-refresh-key-min-32-chars-fanaye-2026
AUTH_REFRESH_TOKEN_EXPIRES_IN=7d

# Two-Factor Authentication (TOTP)
TWO_FACTOR_APP_NAME="Fanaye Technologies"

# WebAuthn / Passkeys
RP_ID=localhost
RP_NAME="Fanaye Technologies"
EXPECTED_ORIGIN=http://localhost:3000

# Transactional Email (Resend)
RESEND_API_KEY=re_demo_sample_key
MAIL_DEFAULT_EMAIL=noreply@fanaye.com
MAIL_DEFAULT_NAME="Fanaye Technologies"
