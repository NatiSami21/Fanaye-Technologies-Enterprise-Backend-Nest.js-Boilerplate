// Prisma Schema for Fanaye Technologies Enterprise Platform
// Database: PostgreSQL 16 with Prisma 7 Adapter

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum RoleEnum {
  ADMIN
  USER
  AUDITOR
}

enum StatusEnum {
  ACTIVE
  INACTIVE
  LOCKED
  PENDING
}

enum TransactionStatus {
  PAID
  PENDING
  OVERDUE
  DECLINED
}

model User {
  id                  String             @id @default(uuid())
  email               String             @unique
  password            String?
  firstName           String?
  lastName            String?
  role                RoleEnum           @default(USER)
  status              StatusEnum         @default(PENDING)
  isTwoFactorEnabled  Boolean            @default(false)
  twoFactorSecret     String?
  failedLoginAttempts Int                @default(0)
  lockoutExpiresAt    DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  sessions            Session[]
  auditLogs           AuditLog[]
  transactions        Transaction[]
  passkeys            PasskeyCredential[]

  @@map("users")
}

model Session {
  id          String   @id @default(uuid())
  userId      String
  token       String   @unique
  deviceId    String?
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasskeyCredential {
  id          String   @id @default(uuid())
  userId      String
  credentialId String  @unique
  publicKey   Bytes
  counter     BigInt   @default(0)
  transports  String[]
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkey_credentials")
}

model Transaction {
  id          String            @id @default(uuid())
  userId      String
  amount      Decimal           @db.Decimal(12, 2)
  currency    String            @default("USD")
  status      TransactionStatus @default(PENDING)
  reference   String            @unique
  description String?
  category    String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("transactions")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  entity      String
  entityId    String?
  deviceId    String?
  userAgent   String?
  ipAddress   String?
  details     Json?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity])
  @@map("audit_logs")
}
